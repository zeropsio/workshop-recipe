{
  "name": "workshop-recipe",
  "version": "1.0.0",
  "description": "Deck Renderer workshop app — markdown slides rendered by horizontally scaled workers on Zerops.",
  "author": "Zerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeropsio/workshop-recipe.git"
  },
  "homepage": "https://github.com/zeropsio/workshop-recipe",
  "bugs": {
    "url": "https://github.com/zeropsio/workshop-recipe/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @deck/shared && npm run build -w @deck/engine && npm run build -w @deck/api && npm run build -w @deck/worker && npm run build -w @deck/frontend",
    "test": "vitest run",
    "replicas": "tsx scripts/replicas.ts",
    "replicas:prod": "REPLICAS=3 tsx scripts/replicas.ts",
    "migrate": "npm run migrate -w @deck/api"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "keywords": [
    "zerops",
    "workshop",
    "nats",
    "valkey",
    "postgresql",
    "playwright",
    "vite"
  ]
}
