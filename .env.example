# API
PORT=3000
# Zerops sets HOST=:: (dual-stack). Locally 0.0.0.0 is fine. CORS accepts any origin, no APP_URL needed.
HOST=0.0.0.0
API_URL=http://localhost:3000

# Bind these to Zerops service connection strings when the project exists.
# Local `npm run dev` runs without them (in-memory store + inline worker).
DATABASE_URL=
NATS_URL=
NATS_HOST=
NATS_PORT=
NATS_USER=
NATS_PASSWORD=
VALKEY_URL=

# Optional namespace so a dev deployment can share db/cache/queue with stage. Unset = public schema, Valkey db 0, subject deck.jobs.
DECK_DB_SCHEMA=
DB_NAME=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
NATS_SUBJECT=

# Worker
WORKER_ID=
RENDER_DRIVER=stub
RENDER_SPIN_MS=400

